# Copy to .env. Shell environment variables take precedence over this file.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Required. PostgreSQL connection string.
# With the local Compose setup use localhost:5432 and the database/user in
# docker-compose.yml. See docs/development.md.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/touchline
# Required. Private random value of at least 32 characters; replace before use.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=touchline-api
JWT_AUDIENCE=touchline-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
