# Copy to .env.local (or .env.development) and adjust for your backend.
#
# REST API origin, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# WebSocket origin only. The client appends /ws/matches/:matchId.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:4000

# demo = labelled offline sample data. Omit (or any other value) = real API.
NEXT_PUBLIC_TOUCHLINE_DATA=

# Next.js server-side rendering and browser calls both use the URLs above.
# They are public values, never put secrets here.
